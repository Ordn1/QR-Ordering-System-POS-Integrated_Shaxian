# Copy to .env and fill in. .env is git-ignored and never committed.

# PostgreSQL. Local Homebrew installs commonly use trust auth, in which case
# the password segment is omitted entirely. Add it as
# shaxian_app:<password>@ if your pg_hba.conf requires one.
DATABASE_URL=postgresql+asyncpg://shaxian_app@localhost:5432/shaxian_ordering

# Minimum 32 random bytes, unique per deployment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated. The Vite dev server origin.
CORS_ORIGINS=http://localhost:5173
