# Copy to .env and fill in. .env is git-ignored and never committed.

# PostgreSQL. Local Homebrew installs commonly use trust auth, in which case
# the password segment is omitted entirely. Add it as
# shaxian_app:<password>@ if your pg_hba.conf requires one.
DATABASE_URL=postgresql+asyncpg://shaxian_app@localhost:5432/shaxian_ordering

# Minimum 32 random bytes, unique per deployment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated origins allowed to call the API. Pages served by the Vite
# dev server reach the API through its proxy, but list every address a
# browser opens the app on. For an Alpha test over LAN HTTPS, add the
# laptop's address, e.g.:
#   CORS_ORIGINS=https://localhost:5173,https://192.168.1.10:5173
CORS_ORIGINS=http://localhost:5173

# The address diners and staff open. Table QR codes and PayMongo return links
# are built from it; a localhost host is swapped for the laptop's LAN IP.
# Use https://localhost:5173 once mkcert certificates are in frontend/certs/.
FRONTEND_BASE_URL=http://localhost:5173

# Set to true whenever the app is served over HTTPS, so the staff session
# cookie is never sent over plain HTTP.
COOKIE_SECURE=false

# PayMongo sandbox (test) keys. Leave empty for offline LAN mode: online
# payment then falls back to the cashier.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Table session lifecycle. A session with no order closes after
# SESSION_IDLE_MINUTES; one whose orders are all paid or voided closes
# SESSION_SETTLED_MINUTES after the last order. Checked every
# SESSION_SWEEP_SECONDS and whenever a table's QR code is scanned.
# SESSION_IDLE_MINUTES=30
# SESSION_SETTLED_MINUTES=45
# SESSION_SWEEP_SECONDS=60
# SESSION_MAX_AGE_HOURS=3
